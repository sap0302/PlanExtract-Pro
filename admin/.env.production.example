# Production — admin.planextractpro.com
# Copy to admin/.env on the Ultahost Windows VPS. Do not commit real secrets.

MAIN_APP_URL="https://planextractpro.com"

# Must match ADMIN_SERVICE_TOKEN on the main app
ADMIN_SERVICE_TOKEN=

ADMIN_EMAIL=
# bcrypt hash. In a .env file every $ must be escaped as \$.
# Hosting control-panel env fields usually do NOT need escaping.
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Administrator

# Must differ from the main app's NEXTAUTH_SECRET
NEXTAUTH_SECRET=
NEXTAUTH_URL="https://admin.planextractpro.com"
AUTH_URL="https://admin.planextractpro.com"
AUTH_TRUST_HOST=true
