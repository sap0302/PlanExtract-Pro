# Base URL of the main PlanExtract Pro app that owns the database.
MAIN_APP_URL=http://localhost:3000

# Shared secret for /api/internal/* on the main app. Must match ADMIN_SERVICE_TOKEN
# there exactly, be at least 32 characters, and never be exposed to a browser.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SERVICE_TOKEN=

# Admin sign-in credentials. ADMIN_PASSWORD_HASH is a bcrypt hash, not a password.
# Generate with: node scripts/hash-password.mjs "your-password"
#
# IMPORTANT: in a .env file every $ in the hash must be escaped as \$, because
# dotenv treats $name as a variable reference and would otherwise strip it.
#   ADMIN_PASSWORD_HASH=\$2b\$12\$abc...
# Pasting into a hosting provider's environment UI needs no escaping.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Administrator

# Session signing secret for this app. Must differ from the main app's NEXTAUTH_SECRET
# so a session from one is never valid on the other.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3100
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
