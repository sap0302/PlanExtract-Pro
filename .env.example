# Local development. Copy to .env and fill in secrets.
DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
ENCRYPTION_KEY=
ADMIN_SERVICE_TOKEN=

# Optional AI defaults (users can also set keys in Settings)
# ANTHROPIC_API_KEY=
CLAUDE_MODEL="claude-opus-4-6"

# SMTP — leave SMTP_PASSWORD empty to keep mail disabled
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="info@steppenstoneco.com"
SMTP_PASSWORD=
EMAIL_FROM="PlanExtract Pro <info@steppenstoneco.com>"
APP_URL="http://localhost:3000"
