# Production — planextractpro.com
# Copy to .env on the Ultahost Windows VPS. Do not commit real secrets.

DATABASE_URL="file:./prisma/prod.db"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# Must be the public HTTPS origin of this app (no trailing slash)
NEXTAUTH_URL="https://planextractpro.com"
AUTH_URL="https://planextractpro.com"
AUTH_TRUST_HOST=true

# Same-server loopback so re-extract does not bounce through public HTTPS
INTERNAL_APP_URL="http://127.0.0.1:3000"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Must match ADMIN_SERVICE_TOKEN in the admin app on admin.planextractpro.com
ADMIN_SERVICE_TOKEN=

APP_URL="https://planextractpro.com"
EMAIL_FROM="PlanExtract Pro <info@steppenstoneco.com>"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="info@steppenstoneco.com"
SMTP_PASSWORD=

CLAUDE_MODEL="claude-opus-4-6"
HIGH_DPI_RENDER=true
PDF_RENDER_SCALE=2.5
